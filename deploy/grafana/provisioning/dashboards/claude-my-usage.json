          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse-langfuse"
          },
          "editorType": "sql",
          "format": 0,
          "rawSql": "SELECT toStartOfDay(o.start_time) AS time, toFloat64(sum(o.effective_cost)) AS cost FROM default.observations_eff o JOIN default.traces t ON o.trace_id = t.id WHERE $__timeFilter(o.start_time) AND o.type='GENERATION' AND t.name NOT LIKE 'Execute evaluator%' AND t.user_id = '${user}' GROUP BY time ORDER BY time"
