      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse-langfuse"
          },
          "editorType": "sql",
          "format": 1,
          "rawSql": "SELECT o.provided_model_name AS model, toFloat64(sum(o.effective_cost)) AS cost FROM default.observations_eff o JOIN default.traces t ON o.trace_id = t.id WHERE $__timeFilter(o.start_time) AND o.type='GENERATION' AND t.name NOT LIKE 'Execute evaluator%' AND t.user_id = '${user}' AND o.provided_model_name IS NOT NULL GROUP BY model ORDER BY cost DESC"
        }
