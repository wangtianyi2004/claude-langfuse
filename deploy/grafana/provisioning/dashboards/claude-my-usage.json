    },
    {
      "id": 7,
      "type": "stat",
      "title": "Tool Accept Rate",
      "description": "% of tool calls you approved vs rejected",
      "gridPos": {
        "x": 20,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse-langfuse"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "min": 0,
          "max": 100,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 70
              },
              {
                "color": "green",
                "value": 90
              }
            ]
          },
          "noValue": "N/A"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "orientation": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse-langfuse"
          },
          "editorType": "sql",
          "format": 1,
          "rawSql": "SELECT round(sum(toInt64OrZero(JSONExtractString(metadata['tool_decisions'],'accept'))) * 100.0 / greatest(sum(toInt64OrZero(JSONExtractString(metadata['tool_decisions'],'accept'))) + sum(toInt64OrZero(JSONExtractString(metadata['tool_decisions'],'reject'))), 1), 1) AS accept_rate FROM default.traces WHERE $__timeFilter(timestamp) AND user_id = '${user}' AND is_deleted = 0 AND metadata['tool_decisions'] != ''"
        }
      ]
    },
