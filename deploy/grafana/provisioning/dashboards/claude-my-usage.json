          "format": 1,
          "rawSql": "SELECT t.user_id, toFloat64(round(sum(o.effective_cost), 2)) AS cost_usd, toFloat64(count(DISTINCT t.session_id)) AS sessions, toFloat64(sum(toInt64OrZero(t.metadata['commit_count']))) AS commits, round(sum(toInt64OrZero(JSONExtractString(t.metadata['tool_decisions'],'accept'))) * 100.0 / greatest(sum(toInt64OrZero(JSONExtractString(t.metadata['tool_decisions'],'accept'))) + sum(toInt64OrZero(JSONExtractString(t.metadata['tool_decisions'],'reject'))), 1), 1) AS accept_rate_pct, round(sum(o.effective_cost) / greatest(sum(toInt64OrZero(t.metadata['commit_count'])), 1), 2) AS cost_per_commit FROM default.traces t JOIN default.observations_eff o ON o.trace_id = t.id WHERE $__timeFilter(t.timestamp) AND o.type='GENERATION' AND t.name NOT LIKE 'Execute evaluator%' AND t.is_deleted = 0 AND t.user_id IS NOT NULL GROUP BY t.user_id ORDER BY cost_usd DESC"
        }
