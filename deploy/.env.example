# ============ Langfuse 后端密钥 ============
# 用 python3 -c "import secrets; print(secrets.token_hex(32))" 生成
NEXTAUTH_SECRET=<generate: secrets.token_hex(32)>
# 用 python3 -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())" 生成
SALT=<generate: base64(token_bytes(32))>
ENCRYPTION_KEY=<generate: secrets.token_hex(32)>
POSTGRES_PASSWORD=<generate>
CLICKHOUSE_PASSWORD=<generate>
REDIS_AUTH=<generate>
MINIO_ROOT_PASSWORD=<generate>
GRAFANA_ADMIN_PASSWORD=<generate>

# ============ Langfuse Web 对外地址 ============
NEXTAUTH_URL=http://<YOUR_SERVER_IP>:3000

# ============ Claude Code（可选，容器内使用）============
ANTHROPIC_API_KEY=sk-ant-...

# ============ Langfuse 项目 Keys（第一次启动后在 UI 创建，再回填）============
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
